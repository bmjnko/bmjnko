---
import Base from '../../layouts/Base.astro';
import MemoList from '../../components/MemoList.astro';
import { getMemos } from '../../lib/memo';
import Bi from '../../components/Bi.astro';
import { t } from '../../lib/i18n';

const memos = await getMemos();
---

<Base title="Memo" description="짧은 생각과 기록.">
  <header class="head">
    <h1 class="page-title">Memo</h1>
    <Bi as="p" class="muted" ko={t.memoSubtitle.ko} en={t.memoSubtitle.en} />
  </header>
  <MemoList memos={memos} />
</Base>

<style>
  .head {
    margin-bottom: 2rem;
  }

  .head p {
    margin-top: 0.4rem;
  }
</style>
