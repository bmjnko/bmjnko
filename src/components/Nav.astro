---
import { SITE } from '../lib/site';

const path = Astro.url.pathname;
const isMemo = path === '/memo' || path.startsWith('/memo/');

const tabs = [
  { href: '/', label: 'About', active: !isMemo },
  { href: '/memo', label: 'Memo', active: isMemo },
];
---

<header class="container site-header">
  <a href="/" class="brand">{SITE.name}</a>
  <nav aria-label="주 메뉴">
    <ul>
      {
        tabs.map((tab) => (
          <li>
            <a href={tab.href} class:list={['tab', { active: tab.active }]} aria-current={tab.active ? 'page' : undefined}>
              {tab.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2rem 0;
  }

  .brand {
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tab {
    position: relative;
    display: inline-block;
    padding-block: 0.15rem;
    text-decoration: none;
    color: var(--muted);
  }

  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ease);
  }

  .tab:hover {
    color: var(--accent);
  }

  .tab:hover::after,
  .tab.active::after {
    transform: scaleX(1);
  }

  .tab.active {
    color: var(--text);
  }

  .tab.active:hover {
    color: var(--accent);
  }
</style>
